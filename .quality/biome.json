{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"extends": ["../biome.json"],
	"linter": {
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "error"
				},
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 50,
						"skipBlankLines": true
					}
				},
				"useMaxParams": {
					"level": "error"
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["test/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": {
							"level": "off"
						}
					}
				}
			}
		}
	]
}
