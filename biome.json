{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"enabled": true,
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"security": {
				"noSecrets": {
					"level": "error",
					"options": {
						"entropyThreshold": 50
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/screen-font.ts"],
			"linter": {
				"rules": {
					"security": {
						"noSecrets": {
							"level": "off"
						}
					}
				}
			}
		}
	]
}
