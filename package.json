{
	"name": "my-little-software-factory",
	"version": "0.1.0",
	"description": "The control plane of my little software factory. A terminal app that observes tickets and issues work to agents.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"factory": "./bin/factory-bin.mjs"
	},
	"files": [
		"bin/factory-bin.mjs",
		"src/binary-install.mjs"
	],
	"scripts": {
		"build": "bun run scripts/build-binary.ts",
		"dev": "bun --watch src/factory.ts --config config/development.toml",
		"gallery": "bun bin/factory-gallery.mjs",
		"test": "bun test --parallel --isolate --timeout=$([ -n \"$CI\" ] && printf 60000 || printf 30000)",
		"test:changed": "bun test --changed=${TEST_CHANGED_BASE:-origin/main} --isolate --timeout=$([ -n \"$CI\" ] && printf 60000 || printf 30000)",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"font": "bun scripts/generate-screen-font.ts && biome check --write scripts/screen-font.ts",
		"screenshots": "bun scripts/generate-screenshots.ts",
		"hero": "bun scripts/generate-herdr-hero.ts",
		"mutate": "bash scripts/mutate.sh",
		"lint": "biome check .",
		"fmt": "biome check --write .",
		"typecheck": "tsc"
	},
	"engines": {
		"bun": ">=1.3.0",
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/SeriousJul/my-little-software-factory"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@hughescr/stryker-bun-runner": "^1",
		"@opentui/core": "^0.5.11",
		"@opentui/react": "^0.5.11",
		"@stryker-mutator/core": "^10",
		"@types/bun": "^1.3.4",
		"@types/react": "^19.2.0",
		"fontkit": "^2.0.4",
		"react": "^19.2.0",
		"smol-toml": "^1.8.0",
		"string-width": "^8.2.2",
		"typescript": "^5.9.0",
		"vitepress": "^1.6.4"
	}
}
