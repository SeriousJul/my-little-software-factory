{
	"name": "my-little-software-factory",
	"version": "0.1.0",
	"description": "The control plane of my little software factory. A terminal app that observes tickets and issues work to agents.",
	"type": "module",
	"license": "MIT",
	"bin": {
		"factory": "./bin/factory.mjs"
	},
	"files": [
		"bin/factory.mjs",
		"config/default.toml",
		"src"
	],
	"scripts": {
		"dev": "bun --watch src/factory.ts --config config/development.toml",
		"gallery": "bun bin/factory-gallery.mjs",
		"test": "bun test --isolate --parallel --timeout=$([ -n \"$CI\" ] && printf 60000 || printf 30000)",
		"docs:dev": "vitepress dev docs",
		"docs:build": "vitepress build docs",
		"docs:preview": "vitepress preview docs",
		"font": "bun scripts/generate-screen-font.ts && biome check --write scripts/screen-font.ts",
		"screenshots": "bun scripts/generate-screenshots.ts",
		"hero": "bun scripts/generate-herdr-hero.ts",
		"lint": "biome check .",
		"fmt": "biome check --write .",
		"typecheck": "tsc"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"dependencies": {
		"@opentui/core": "^0.5.11",
		"@opentui/react": "^0.5.11",
		"react": "^19.2.0",
		"smol-toml": "^1.8.0",
		"string-width": "^8.2.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@types/bun": "^1.3.4",
		"@types/react": "^19.2.0",
		"fontkit": "^2.0.4",
		"typescript": "^5.9.0",
		"vitepress": "^1.6.4"
	}
}
